
# =============================================================================
# ROSCA Backend - Environment Variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---------- App ----------
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database (Neon Postgres) ----------
# Get both from https://console.neon.tech -> your project -> Connection Details
DATABASE_URL=postgresql://neondb_owner:npg_2wi0oRbOugrV@ep-noisy-butterfly-b5vyt17b-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:npg_2wi0oRbOugrV@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full

# ---------- Auth (JWT) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-hex-characters
JWT_REFRESH_SECRET=replace-with-64-hex-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

