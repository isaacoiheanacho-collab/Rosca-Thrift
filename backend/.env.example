# =============================================================================
# ROSCA Backend - Environment Variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This file MUST contain only placeholder values - no real credentials.
# =============================================================================

# ---------- App ----------
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database (Neon Postgres) ----------
# Get both from https://console.neon.tech -> your project -> Connection Details
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full

# ---------- Redis (Upstash) ----------
# Get from https://console.upstash.com -> your database -> TCP tab
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ---------- Auth (JWT) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-hex-characters
JWT_REFRESH_SECRET=replace-with-64-hex-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---------- SMS (textbee) ----------
TEXTBEE_API_KEY=your-textbee-api-key
TEXTBEE_DEVICE_ID=your-device-id
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# ---------- OTP ----------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
DEV_OTP_OVERRIDE=

# ---------- Admin bootstrap ----------
SUPER_ADMIN_PHONE=+447912345678

# ---------- Object storage (Backblaze B2) ----------
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=rosca-receipts-example
S3_ACCESS_KEY_ID=your-key-id
S3_SECRET_ACCESS_KEY=your-application-key

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ROSCA <noreply@rosca.local>"

# ---------- Bank Integration ----------
MONZO_WEBHOOK_SECRET=
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
POOL_ACCOUNT_SORT_CODE=04-00-04
POOL_ACCOUNT_NUMBER=12345678
POOL_ACCOUNT_NAME=ROSCA Pool

# ---------- Business Rules ----------
CONTRIBUTION_PENCE=100000
CIRCLE_SIZE=12
PLATFORM_FEE_BPS=150
TVC_ANNUAL_BPS=200
MAX_TENANTS=50

