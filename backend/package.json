{
  "name": "rosca-backend",
  "version": "0.1.0",
  "description": "ROSCA thrift & savings ledger - backend API",
  "main": "dist/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node --transpile-only src/migrate.ts",
    "smoke": "ts-node --transpile-only scripts/smoke-test.ts",
    "test:kyc": "ts-node --transpile-only scripts/test-kyc.ts",
    "test:provisioning": "ts-node --transpile-only scripts/test-provisioning.ts",
    "test:tenants-read": "ts-node --transpile-only scripts/test-tenants-read.ts",
    "test:contribution": "ts-node --transpile-only scripts/test-contribution-flow.ts",
    "test:visibility": "ts-node --transpile-only scripts/test-tenant-visibility.ts",
    "test:idor": "ts-node --transpile-only scripts/test-idor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "rate-limit-redis": "^6.0.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2"
  }
}